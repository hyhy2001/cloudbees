{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["bun", "react"],
    "lib": ["ESNext"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@plugins/*": ["./src/plugins/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "build.ts", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["node_modules", "dist", "legacy"]
}
